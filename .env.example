# R4R AI Environment Configuration
# Copy this file to .env and fill in your secrets

# General Config
ENVIRONMENT=development
PROJECT_NAME="R4R AI"
API_V1_STR="/api/v1"
SECRET_KEY=supersecret-voice-nexus-jwt-token-key-change-in-production-32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Config
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://app.voicenexus.ai"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=voicenexus
POSTGRES_PASSWORD=voicenexus_secure_pass
POSTGRES_DB=voicenexus_db
DATABASE_URL=postgresql+asyncpg://voicenexus:voicenexus_secure_pass@localhost:5432/voicenexus_db
SYNC_DATABASE_URL=postgresql://voicenexus:voicenexus_secure_pass@localhost:5432/voicenexus_db

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Keys
OPENAI_API_KEY=your-openai-or-gemini-api-key-here
OPENAI_MODEL=gpt-4o

# Speech-to-Text (STT) Provider Keys
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_MODEL=nova-2

# Text-to-Speech (TTS) Provider Keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
AMAZON_POLLY_REGION=us-east-1

# Telephony Provider Keys
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_PUBLIC_KEY=your-telnyx-public-key
TELNYX_SIP_CONNECTION_ID=your-connection-id
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Calendar Integrations
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# Vector Database / RAG
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=500
CHUNK_OVERLAP=50
